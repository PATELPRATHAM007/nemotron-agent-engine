PROJECT_NAME="Async Document Processing Service"
ENVIRONMENT="development"
DEBUG=True
HOST="0.0.0.0"
PORT=8000

# PostgreSQL Database Configuration
DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/doc_processing_db"

# Redis Broker Configuration
REDIS_URL="redis://localhost:6379/0"
QUEUE_NAME="document_processing_queue"

# Logger Configuration
LOG_MAX_BYTES=1073741824
LOG_BACKUP_COUNT=3
LOG_LEVEL=INFO
LOG_CONSOLE=false

# ==============================================================================
# Google Compute Engine (GCP) / vLLM Inference Engine Configuration
# ==============================================================================
# Replace with the external IP of your GCP Spot GPU instance (e.g., http://34.123.45.67:8000/v1)
NEMOTRON_API_BASE=http://localhost:8000/v1
NEMOTRON_API_KEY=EMPTY
NEMOTRON_MODEL_NAME=nvidia/Nemotron-3-Ultra
NEMOTRON_MAX_TOKENS=16384
NEMOTRON_ENABLE_THINKING=true

# Google Drive / Cloud Model Weights Storage Path
GDRIVE_MODEL_PATH=/content/drive/MyDrive/models/nemotron-3-ultra-bf16

# Optional: Google GenAI Tier-1 Fast Preprocessor (Jio Gemini Plan)
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-3.6-flash
